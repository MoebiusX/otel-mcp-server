# ─── Backend URLs ──────────────────────────────────────────────────────────
# Point these at your observability stack

# Traces — provider-agnostic layer. Pick one backend with TRACES_PROVIDER
# (default jaeger). The verb surface (traces_search, trace_get,
# traces_services, traces_operations, traces_dependencies) is the same
# across providers; unsupported capabilities return a clear error.
TRACES_PROVIDER=jaeger
JAEGER_URL=http://localhost:16686
# TRACES_TEMPO_URL=http://localhost:3200       # or legacy TEMPO_URL
# TRACES_ZIPKIN_URL=http://localhost:9411      # or legacy ZIPKIN_URL
# TRACES_SKYWALKING_URL=http://localhost:12800 # or legacy SKYWALKING_URL

PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100

# ─── Optional: Prometheus path prefix ─────────────────────────────────────
# If Prometheus is behind a reverse proxy with a path prefix (e.g. /prometheus/)
# PROMETHEUS_PATH_PREFIX=/prometheus

# ─── Optional: Application API (for ZK proofs and system health) ──────────
# Only needed if using the zk-proofs or system-health tool groups
# APP_API_URL=http://localhost:5000

# ─── Optional: Elasticsearch / OpenSearch ─────────────────────────────────
# Set to enable es_* tools (search, cluster health, indices, mappings)
# ELASTICSEARCH_URL=http://localhost:9200

# ─── Optional: Alertmanager ───────────────────────────────────────────────
# Set to enable alertmanager_* tools (active alerts, silences, groups)
# ALERTMANAGER_URL=http://localhost:9093

# ─── Optional: Cilium (eBPF networking) ───────────────────────────────────
# Set to enable cilium_* tools (endpoints, identities, policy, services, nodes).
# Point at the cilium-agent REST API. NOTE: this is the agent control-plane
# surface only — L3/L7 flow observability (Hubble) is gRPC and not yet wired.
# CILIUM_URL=http://localhost:9234

# ─── Optional: Kubernetes (CRD reader) ────────────────────────────────────
# Read-only kube-apiserver access — health, API discovery, generic resource/CRD
# listing, and events. Auto-enabled in-cluster via the ServiceAccount token mount.
# Out-of-cluster, set KUBERNETES_URL and a token:
# KUBERNETES_URL=https://my-cluster:6443
# KUBERNETES_TOKEN=<bearer-token>           # or KUBERNETES_TOKEN_FILE=/path/to/token
# KUBERNETES_CA_FILE=/path/to/ca.crt        # for TLS validation
# KUBERNETES_INSECURE_SKIP_TLS_VERIFY=true  # dev only — skips TLS verification

# ─── Optional: ClickHouse ─────────────────────────────────────────────────
# Set to enable clickhouse_* tools (read-only SQL query, table discovery,
# log search). Point at the ClickHouse HTTP interface (default port 8123).
# CLICKHOUSE_URL=http://localhost:8123
# CLICKHOUSE_AUTH_BASIC=default:           # user:password for HTTP Basic auth

# ─── Optional: Pyroscope (continuous profiling) ───────────────────────────
# Set to enable pyroscope_* tools (profile types, labels, render top functions).
# PYROSCOPE_URL=http://localhost:4040
# PYROSCOPE_AUTH_TOKEN=my-pyroscope-token

# ─── Optional: Open Policy Agent ──────────────────────────────────────────
# Set to enable opa_* tools (health, policies, data/decision queries).
# OPA_URL=http://localhost:8181
# OPA_AUTH_TOKEN=my-opa-token

# ─── Optional: Service mesh (Envoy / Consul / Kong / Traefik) ─────────────
# Each is independent — set only the ones you run.
# ENVOY_ADMIN_URL=http://localhost:9901    # Envoy admin API
# CONSUL_URL=http://localhost:8500         # Consul HTTP API
# CONSUL_AUTH_TOKEN=my-consul-acl-token    # ACL token (sent as Bearer)
# KONG_ADMIN_URL=http://localhost:8001     # Kong Admin API
# KONG_AUTH_HEADER=Kong-Admin-Token: xxx   # if the Admin API is protected
# TRAEFIK_URL=http://localhost:8080        # Traefik API

# ─── Optional: InfluxDB ───────────────────────────────────────────────────
# Set to enable influx_* tools (InfluxQL query, databases, health).
# INFLUX_URL=http://localhost:8086
# INFLUX_AUTH_BASIC=user:password          # InfluxDB 1.x
# INFLUX_AUTH_HEADER=Token my-token        # InfluxDB 2.x (needs a DBRP mapping)

# ─── Optional: OpenTSDB ───────────────────────────────────────────────────
# Set to enable opentsdb_* tools (version, suggest, query).
# OPENTSDB_URL=http://localhost:4242

# ─── Optional: Graylog ────────────────────────────────────────────────────
# Set to enable graylog_* tools (system, streams, search).
# GRAYLOG_URL=http://localhost:9000
# GRAYLOG_AUTH_BASIC=admin:password        # or <api-token>:token

# ─── Optional: Pinpoint ───────────────────────────────────────────────────
# Set to enable pinpoint_* tools (applications, server time, GET passthrough).
# PINPOINT_URL=http://localhost:8080

# ─── Optional: Collection pipelines (Fluent Bit / Beats / Vector / Alloy) ──
# Set any of these to enable the matching pipeline_* tool (agent health/throughput).
# FLUENTBIT_URL=http://localhost:2020   # Fluent Bit HTTP monitoring server
# BEATS_URL=http://localhost:5066       # Beats HTTP monitoring endpoint
# VECTOR_URL=http://localhost:8686      # Vector API (GraphQL + /health)
# ALLOY_URL=http://localhost:12345      # Grafana Alloy

# ─── Backend Authentication ───────────────────────────────────────────────
# The MCP server authenticates to backends using these credentials.
# Each backend supports: _AUTH_TOKEN (Bearer), _AUTH_BASIC (user:pass), _AUTH_HEADER (raw)
# Trace providers keep their per-vendor prefixes: JAEGER_AUTH_*, TEMPO_AUTH_*,
# ZIPKIN_AUTH_*, SKYWALKING_AUTH_*.
#
# JAEGER_AUTH_TOKEN=my-jaeger-token
# PROMETHEUS_AUTH_TOKEN=my-prom-token
# PROMETHEUS_AUTH_BASIC=admin:secret
# LOKI_AUTH_TOKEN=my-loki-token
# LOKI_TENANT_ID=my-tenant          # Sets X-Scope-OrgID for multi-tenant Loki
# APP_API_AUTH_TOKEN=my-api-token
# ELASTICSEARCH_AUTH_BASIC=elastic:changeme
# ALERTMANAGER_AUTH_TOKEN=my-am-token

# ─── Client Authentication (HTTP mode only) ──────────────────────────────
# API keys that clients must present to use the MCP server.
# Option 1: Inline JSON (recommended for containers / K8s Secrets)
# MCP_AUTH_KEYS={"keys":[{"id":"agent-1","key":"sk-xxx","description":"My AI agent"}]}
#
# Option 2: File path (K8s mounted secret or local file)
# MCP_AUTH_KEYS_FILE=/etc/otel-mcp/auth-keys.json
#
# If neither is set, the server checks ./auth-keys.json and ~/.otel-mcp/auth-keys.json

# ─── Optional: HTTP transport ─────────────────────────────────────────────
# By default, the server runs on stdio (for Claude Desktop / Copilot).
# Set this to enable HTTP transport for remote access.
# MCP_HTTP_PORT=3001

# ─── Optional: Timeout ───────────────────────────────────────────────────
# MCP_TIMEOUT_MS=15000
