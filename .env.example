# ─── Backend URLs ──────────────────────────────────────────────────────────
# Point these at your observability stack

# Traces — provider-agnostic layer. Pick one backend with TRACES_PROVIDER
# (default jaeger). The verb surface (traces_search, trace_get,
# traces_services, traces_operations, traces_dependencies) is the same
# across providers; unsupported capabilities return a clear error.
TRACES_PROVIDER=jaeger
JAEGER_URL=http://localhost:16686
# TRACES_TEMPO_URL=http://localhost:3200       # or legacy TEMPO_URL
# TRACES_ZIPKIN_URL=http://localhost:9411      # or legacy ZIPKIN_URL
# TRACES_SKYWALKING_URL=http://localhost:12800 # or legacy SKYWALKING_URL

PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100

# ─── Optional: Prometheus path prefix ─────────────────────────────────────
# If Prometheus is behind a reverse proxy with a path prefix (e.g. /prometheus/)
# PROMETHEUS_PATH_PREFIX=/prometheus

# ─── Optional: Application API (for ZK proofs and system health) ──────────
# Only needed if using the zk-proofs or system-health tool groups
# APP_API_URL=http://localhost:5000

# ─── Optional: Elasticsearch / OpenSearch ─────────────────────────────────
# Set to enable es_* tools (search, cluster health, indices, mappings)
# ELASTICSEARCH_URL=http://localhost:9200

# ─── Optional: Alertmanager ───────────────────────────────────────────────
# Set to enable alertmanager_* tools (active alerts, silences, groups)
# ALERTMANAGER_URL=http://localhost:9093

# ─── Optional: Cilium (eBPF networking) ───────────────────────────────────
# Set to enable cilium_* tools (endpoints, identities, policy, services, nodes).
# Point at the cilium-agent REST API. NOTE: this is the agent control-plane
# surface only — L3/L7 flow observability (Hubble) is gRPC and not yet wired.
# CILIUM_URL=http://localhost:9234

# ─── Optional: Grafana Beyla (eBPF auto-instrumentation) ──────────────────
# Set to enable beyla_* tools (service discovery, RED metrics, top routes,
# network flows). Beyla has no query API of its own — it auto-instruments
# processes with eBPF and exports OTel/Prometheus metrics, so point this at the
# Prometheus-compatible store that scrapes Beyla (NOT at Beyla's own port).
# BEYLA_PROMETHEUS_URL=http://localhost:9090
# BEYLA_AUTH_TOKEN=my-prometheus-token       # if the store requires auth

# ─── Optional: Kubernetes (CRD reader) ────────────────────────────────────
# Read-only kube-apiserver access — health, API discovery, generic resource/CRD
# listing, and events. Auto-enabled in-cluster via the ServiceAccount token mount.
# Out-of-cluster, set KUBERNETES_URL and a token:
# KUBERNETES_URL=https://my-cluster:6443
# KUBERNETES_TOKEN=<bearer-token>           # or KUBERNETES_TOKEN_FILE=/path/to/token
# KUBERNETES_CA_FILE=/path/to/ca.crt        # for TLS validation
# KUBERNETES_INSECURE_SKIP_TLS_VERIFY=true  # dev only — skips TLS verification

# ─── Optional: ClickHouse ─────────────────────────────────────────────────
# Set to enable clickhouse_* tools (read-only SQL query, table discovery,
# log search). Point at the ClickHouse HTTP interface (default port 8123).
# CLICKHOUSE_URL=http://localhost:8123
# CLICKHOUSE_AUTH_BASIC=default:           # user:password for HTTP Basic auth

# ─── Optional: Pyroscope (continuous profiling) ───────────────────────────
# Set to enable pyroscope_* tools (profile types, labels, render top functions).
# PYROSCOPE_URL=http://localhost:4040
# PYROSCOPE_AUTH_TOKEN=my-pyroscope-token

# ─── Optional: Open Policy Agent ──────────────────────────────────────────
# Set to enable opa_* tools (health, policies, data/decision queries).
# OPA_URL=http://localhost:8181
# OPA_AUTH_TOKEN=my-opa-token

# ─── Optional: Service mesh (Envoy / Consul / Kong / Traefik) ─────────────
# Each is independent — set only the ones you run.
# ENVOY_ADMIN_URL=http://localhost:9901    # Envoy admin API
# CONSUL_URL=http://localhost:8500         # Consul HTTP API
# CONSUL_AUTH_TOKEN=my-consul-acl-token    # ACL token (sent as Bearer)
# KONG_ADMIN_URL=http://localhost:8001     # Kong Admin API
# KONG_AUTH_HEADER=Kong-Admin-Token: xxx   # if the Admin API is protected
# TRAEFIK_URL=http://localhost:8080        # Traefik API

# ─── Optional: InfluxDB ───────────────────────────────────────────────────
# Set to enable influx_* tools (InfluxQL query, databases, health).
# INFLUX_URL=http://localhost:8086
# INFLUX_AUTH_BASIC=user:password          # InfluxDB 1.x
# INFLUX_AUTH_HEADER=Token my-token        # InfluxDB 2.x (needs a DBRP mapping)

# ─── Optional: OpenTSDB ───────────────────────────────────────────────────
# Set to enable opentsdb_* tools (version, suggest, query).
# OPENTSDB_URL=http://localhost:4242

# ─── Optional: Graylog ────────────────────────────────────────────────────
# Set to enable graylog_* tools (system, streams, search).
# GRAYLOG_URL=http://localhost:9000
# GRAYLOG_AUTH_BASIC=admin:password        # or <api-token>:token

# ─── Optional: Pinpoint ───────────────────────────────────────────────────
# Set to enable pinpoint_* tools (applications, server time, GET passthrough).
# PINPOINT_URL=http://localhost:8080

# ─── Optional: Collection pipelines (Fluent Bit / Beats / Vector / Alloy) ──
# Set any of these to enable the matching pipeline_* tool (agent health/throughput).
# FLUENTBIT_URL=http://localhost:2020   # Fluent Bit HTTP monitoring server
# BEATS_URL=http://localhost:5066       # Beats HTTP monitoring endpoint
# VECTOR_URL=http://localhost:8686      # Vector API (GraphQL + /health)
# ALLOY_URL=http://localhost:12345      # Grafana Alloy

# ─── Backend Authentication ───────────────────────────────────────────────
# The MCP server authenticates to backends using these credentials.
# Each backend supports: _AUTH_TOKEN (Bearer), _AUTH_BASIC (user:pass), _AUTH_HEADER (raw)
# Trace providers keep their per-vendor prefixes: JAEGER_AUTH_*, TEMPO_AUTH_*,
# ZIPKIN_AUTH_*, SKYWALKING_AUTH_*.
#
# JAEGER_AUTH_TOKEN=my-jaeger-token
# PROMETHEUS_AUTH_TOKEN=my-prom-token
# PROMETHEUS_AUTH_BASIC=admin:secret
# LOKI_AUTH_TOKEN=my-loki-token
# LOKI_TENANT_ID=my-tenant          # Sets X-Scope-OrgID for multi-tenant Loki
# APP_API_AUTH_TOKEN=my-api-token
# ELASTICSEARCH_AUTH_BASIC=elastic:changeme
# ALERTMANAGER_AUTH_TOKEN=my-am-token

# ─── OAuth 2.0 / OIDC (client-credentials) ───────────────────────────────
# When no static _AUTH_* var is set for a backend, the server can fetch a
# bearer token via the OAuth 2.0 client-credentials grant and refresh it
# transparently. Set <PREFIX>_AUTH_OAUTH_* vars (same PREFIX as above).
#
# Generic OIDC provider (token endpoint discovered from the issuer):
# PROMETHEUS_AUTH_OAUTH_ISSUER=https://idp.example.com/realms/obs
# PROMETHEUS_AUTH_OAUTH_CLIENT_ID=otel-mcp
# PROMETHEUS_AUTH_OAUTH_CLIENT_SECRET=...        # never logged or echoed
# PROMETHEUS_AUTH_OAUTH_SCOPE=metrics:read       # optional
#
# Explicit token endpoint (skip discovery):
# LOKI_AUTH_OAUTH_TOKEN_URL=https://idp.example.com/oauth2/token
# LOKI_AUTH_OAUTH_CLIENT_ID=otel-mcp
# LOKI_AUTH_OAUTH_CLIENT_SECRET=...
#
# Microsoft Entra ID (Azure AD) preset — tenant + audience derive the rest:
# TEMPO_AUTH_OAUTH_PROVIDER=entra
# TEMPO_AUTH_OAUTH_TENANT=00000000-0000-0000-0000-000000000000
# TEMPO_AUTH_OAUTH_CLIENT_ID=...
# TEMPO_AUTH_OAUTH_CLIENT_SECRET=...
# TEMPO_AUTH_OAUTH_AUDIENCE=api://obs-backend     # → scope api://obs-backend/.default
#
# Google Cloud preset:
# GRAFANA_AUTH_OAUTH_PROVIDER=google
# GRAFANA_AUTH_OAUTH_CLIENT_ID=...
# GRAFANA_AUTH_OAUTH_CLIENT_SECRET=...
# GRAFANA_AUTH_OAUTH_SCOPE=https://www.googleapis.com/auth/monitoring.read

# ─── Client Authentication (HTTP mode only) ──────────────────────────────
# API keys that clients must present to use the MCP server.
# Option 1: Inline JSON (recommended for containers / K8s Secrets)
# MCP_AUTH_KEYS={"keys":[{"id":"agent-1","key":"sk-xxx","description":"My AI agent"}]}
#
# Option 2: File path (K8s mounted secret or local file)
# MCP_AUTH_KEYS_FILE=/etc/otel-mcp/auth-keys.json
#
# If neither is set, the server checks ./auth-keys.json and ~/.otel-mcp/auth-keys.json

# ─── HTTP transport ───────────────────────────────────────────────────────
# By default the server runs on stdio (for Claude Desktop / Copilot).
# HTTP mode is a CLI flag, not an env var:   otel-mcp-server --http 3001
# Restrict which skills load with:           otel-mcp-server --tools traces,metrics,logs

# ─── Optional: Timeout ───────────────────────────────────────────────────
# MCP_TIMEOUT_MS=15000

# ─── Optional: Write tools (mutating operations) ─────────────────────────
# Write tools are DISABLED by default — the server is read-only out of the box.
# Set this to advertise & enable mutating tools (e.g. Grafana dashboard/folder
# provisioning). Accepts true/1/yes/on. The backend token must also carry the
# needed write scopes (Grafana: dashboards:write/delete, folders:write).
# MCP_ENABLE_WRITES=true

# ═════════════════════════════════════════════════════════════════════════
#  Just-in-Time (JIT) Privileged Identity  — HTTP transport only
# ═════════════════════════════════════════════════════════════════════════
# Exchange long-lived static keys for short-lived, scoped, rotatable session
# tokens (OWASP MCP Top 10: MCP01/MCP02/MCP07/MCP08). Opt-in and off by default.
#   off      — legacy: static keys call tools directly (default)
#   enabled  — POST /auth/token is live; static keys still work (migration)
#   required — zero standing privilege: static keys may ONLY mint tokens
# MCP_JIT_MODE=off

# Token TTL in seconds, and the cap for a caller-requested ttlSeconds (60–3600)
# MCP_JIT_TTL_SECONDS=900

# Absolute lifetime cap per token lineage — rotation can never exceed it (ttl–86400)
# MCP_JIT_MAX_LIFETIME_SECONDS=28800

# Upper bound on concurrently active tokens (DoS / leak guard)
# MCP_JIT_MAX_ACTIVE_TOKENS=1000

# Where token + single-use replay state lives.
#   memory   — in-process (default). A restart invalidates outstanding tokens,
#              which is the right failure mode for ONE instance.
#   <module> — module specifier for an operator-supplied shared-store adapter
#              exporting createJitStore(). REQUIRED for multiple replicas:
#              without it a token minted on one replica is unknown on another
#              and revocation only applies where it was processed.
#              See README "High availability (multiple replicas)".
# MCP_JIT_STORE=memory

# ═════════════════════════════════════════════════════════════════════════
#  Enterprise-Managed Authorization (MCP ext-auth · ID-JAG)
# ═════════════════════════════════════════════════════════════════════════
# Let your corporate IdP (Okta, Entra ID, SSO) decide who may use this server
# instead of locally provisioned API keys. Setting ISSUER + AUDIENCE enables it
# and auto-enables the JIT token infrastructure.
#
# NOTE: ISSUER and JWKS_URL must be https (loopback http is allowed for local
# IdP simulators). A plaintext JWKS fetch is a key-injection MITM.
# MCP_ENTERPRISE_AUTH_ISSUER=https://idp.example.com
# MCP_ENTERPRISE_AUTH_AUDIENCE=https://mcp.example.com
# MCP_ENTERPRISE_AUTH_RESOURCE=https://mcp.example.com      # default: audience
# MCP_ENTERPRISE_AUTH_JWKS_URL=https://idp.example.com/jwks # default: OIDC discovery
# MCP_ENTERPRISE_AUTH_DEFAULT_SCOPES=traces,metrics         # when the ID-JAG has no scope claim
# MCP_ENTERPRISE_AUTH_MAX_REDEEMED_JTIS=50000               # replay-cache cap

# ═════════════════════════════════════════════════════════════════════════
#  Version gating
# ═════════════════════════════════════════════════════════════════════════
# Guard version-sensitive backend features against detected product versions.
# Unknown versions always pass optimistically.
#   off | warn | enforce
# MCP_VERSION_GATING=off

# ═════════════════════════════════════════════════════════════════════════
#  HTTP session tuning  (pre-2026 clients only)
# ═════════════════════════════════════════════════════════════════════════
# MCP 2026-07-28 clients are stateless and hold no session, so these apply only
# to clients on 2025-11-25 and earlier.
# MCP_SESSION_IDLE_MS=300000      # reap sessions idle this long
# MCP_SESSION_SWEEP_MS=60000      # how often the reaper runs

# ═════════════════════════════════════════════════════════════════════════
#  Multi-backend instances  (advanced)
# ═════════════════════════════════════════════════════════════════════════
# Address several named instances of the same backend and fail over between
# replicas. Two equivalent forms:
#
#   1. Suffixed vars — PROMETHEUS_URL__PROD / PROMETHEUS_URL__STAGING,
#      with auth under the matching prefix (PROMETHEUS__PROD_AUTH_TOKEN).
#   2. Rich JSON in MCP_BACKENDS.
#
# Tools then accept an optional SSRF-safe `target` argument naming the instance.
# A comma-separated <PREFIX>_URL is an ordered failover list.
# MCP_BACKENDS={"prometheus":{"instances":{"prod":{"urls":["http://prom-a:9090","http://prom-b:9090"]}}}}
